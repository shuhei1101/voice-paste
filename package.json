{
  "name": "voice-paste",
  "private": true,
  "description": "外の端末の画面のスクリプトを tsc で生成し、検査するための開発用の依存（常駐アプリには入らない）",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/voice_paste/server/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
