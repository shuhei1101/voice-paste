# dev-docs（develop の worktree）の DocumentTable.matches で、作業ブランチの dev-docs.yaml の id: index の行に当たるファイルを集める
$ cd /mnt/c/Users/shuhe/repo/dev-docs/.claude/worktrees/develop && uv run python -c "$SCRIPT" /mnt/c/Users/shuhe/repo/voice-paste/.claude/worktrees/fix-dev-docs-exclude-pr-deploy-index
```python
import sys
from pathlib import Path
from ruamel.yaml import YAML
from dev_docs.features.sources.types import DocumentTable
from dev_docs.features.documents.loader import collect_files
root = Path(sys.argv[1])
for label, paths in (("変更前", ["docs/**/index.yaml"]), ("変更後", None)):
    row = next(r for r in YAML(typ="safe").load((root/"dev-docs.yaml").read_text(encoding="utf-8"))["documents"] if r["id"]=="index")
    p = paths or row["paths"]
    files = collect_files(root, DocumentTable(id="index", paths=p, schema_path=row["schema"], exclude=row.get("exclude", [])))
    print(f"## {label}: paths={p} -> {len(files)} 件")
    print("\n".join(files))
```
